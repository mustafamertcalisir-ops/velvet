# API configuration — validated at startup (server/src/config.ts), fail-closed
# in staging and production. NAMES ONLY: real values live in the deployment's
# secret manager and are never committed. docs/STAGING.md explains each group.

APP_ENV=staging                        # production | staging | development | test
PORT=8787
HOST=0.0.0.0
MIGRATION_DATABASE_URL=                # the schema owner — used only by the release step (node dist/migrate.mjs); refused as the API's credential
# The API's LEAST-PRIVILEGE login (member of velvet_runtime), either generated (DEC-081, staging on Render) …
DATABASE_RUNTIME_USER=velvet_api       # created/re-asserted by the release step
DATABASE_RUNTIME_PASSWORD=             # generated by the platform; stored by the database only as a SCRAM verifier
# … or given explicitly (manual procedure: infra/postgres/create-runtime-login.sql) — not both:
# DATABASE_URL=
DATABASE_TLS=require                   # require (encrypted) | verify (encrypted + certificate checked) | off (development only)
# DATABASE_CA_CERT=                    # PEM, with DATABASE_TLS=verify (\n escapes allowed)
# DATABASE_POOL_MAX=10                 # per instance; instances × this must stay under the plan's connection limit
PUBLIC_BASE_URL=                       # https://… — the API's public origin (https required outside development)
CORS_ORIGINS=                          # the app's web origin(s), comma-separated; never "*" outside development
TRUST_PROXY_HOPS=1                     # reverse proxies that append X-Forwarded-For (0 = none)
# INTERNAL_ALLOWED_CIDRS=              # optional: /internal/* also requires a caller address in these ranges (never instead of signatures)
LOG_LEVEL=info                         # debug | info | warn | error — structured JSON to stdout

# --- Secrets (≥ 32 characters each) -----------------------------------------------------
OTP_SECRET=
MEDIA_SIGNING_SECRET=

# --- Internal callers (signed requests, scoped keys — docs/SECURITY_MODEL.md) -------------
# {"<key-id>": {"secret": "<≥32 chars>", "scopes": ["review:write", …]}}
# or, with the secret in its own (platform-generated) variable:
# {"<key-id>": {"secretEnv": "INTERNAL_KEY_<NAME>", "scopes": [...]}}   + INTERNAL_KEY_<NAME>=<≥32 chars>
# Scopes: review:write review:media billing:write safety:write retention:run media:reconcile
#         test:otp test:review   ← staging/test only, refused in production
# Staging example (separate keys per caller): runner = test:otp test:review · ops = retention:run media:reconcile
INTERNAL_KEYS_JSON=

# --- SMS (docs/SMS_PROVIDER.md) ------------------------------------------------------------
SMS_PROVIDER=none                      # iletimerkezi | netgsm | none (closed). console / outbox-file / capture are development-only.
ILETIMERKEZI_API_KEY=                  # İleti Merkezi panel → Ayarlar → API (DEC-085)
ILETIMERKEZI_API_HASH=                 # a credential, from the same panel page
ILETIMERKEZI_SENDER=                   # the approved sender name (≤ 11 characters)
# ILETIMERKEZI_BASE_URL=https://api.iletimerkezi.com
NETGSM_USERCODE=
NETGSM_PASSWORD=
NETGSM_HEADER=                         # the sender name registered with the provider
# NETGSM_BASE_URL=https://api.netgsm.com.tr
# SMS_OTP_TEMPLATE=Your verification code is {code}. Do not share it.
# SMS_TEST_NUMBERS=+90555000*          # staging only: codes for these numbers go to the internal test outbox
# SMS_QA_REAL_NUMBERS=                 # staging only: project SIMs (exact +905…), real SMS but QA accounts (DEC-083)

# --- Private object storage (docs/MEDIA_ARCHITECTURE.md) ------------------------------------
STORAGE_DRIVER=s3                      # s3 (any S3-compatible service) | local (development only)
S3_REGION=
S3_ENDPOINT=                           # empty for AWS; the provider's endpoint otherwise (R2, B2, MinIO…)
S3_BUCKET=                             # private bucket: application + member photos, incoming uploads
S3_VERIFICATION_BUCKET=                # a SEPARATE private bucket: identity photos only
S3_ACCESS_KEY_ID=                      # leave EMPTY with workload identity (Render OIDC → AWS: set AWS_ROLE_ARN instead)
S3_SECRET_ACCESS_KEY=
# AWS_ROLE_ARN=                        # Render OIDC (Pro): Render then provides AWS_WEB_IDENTITY_TOKEN_FILE itself — infra/aws/README.md
# S3_FORCE_PATH_STYLE=1               # some S3-compatible services need path-style urls
# MEDIA_DIR=./.media                  # local driver only

# --- Sessions -------------------------------------------------------------------------------
SESSION_TTL_DAYS=60                    # absolute lifetime
SESSION_IDLE_DAYS=30                   # idle lifetime

# --- Retention (docs/DATA_RETENTION.md) — POLICY NOT YET DECIDED --------------------------
# Unset = never purged automatically. Set only after the retention policy is approved.
# ACCOUNT_DELETION_GRACE_HOURS=0
# RETENTION_REMOVED_PROFILE_MEDIA_DAYS=
# RETENTION_RETIRED_APPLICATION_MEDIA_DAYS=
# RETENTION_VERIFICATION_MEDIA_DAYS=
# RETENTION_AUTH_RECORDS_DAYS=
# RETENTION_SAFETY_RECORDS_DAYS=
# RETENTION_AUDIT_DAYS=

# --- Release behaviour ----------------------------------------------------------------------
# MIGRATE_ON_START=0                   # staging/production run `node dist/migrate.mjs` as a release step
APP_TIME_ZONE=Europe/Istanbul          # the product calendar (introductions per day, ages)
# DEV_SEED=1                           # development only: seeds the development membership plan
