# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# build + QA output
dist/
dist-native/
e2e/screenshots/
dist-prod/

# secrets and environment files (DEC-079): only *.example files are committed
.env
.env.*
!.env.example
!**/.env.example

# staging tooling output (QA session tokens, canary values) — never committed, never uploaded
.staging-state.json
.staging-canaries.json
.staging-otp-canaries.json
*.dump
server/.media/

# Generated CloudFormation templates (identifiers only, but per-account)
infra/aws/out/
# Staging tool outputs
.staging-db-checks.json
dist-staging/
